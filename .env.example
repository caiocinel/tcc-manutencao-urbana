# ============================================================
# Central de Inteligência Urbana — Template de Ambiente
# ============================================================
# Copie para .env (produção) ou backend-python/.env (dev) e
# preencha com valores reais. NUNCA commite o .env real.
#
# Gere chaves com: openssl rand -hex 32
# ============================================================

# ----------------------------------------------------------------------------
# SEGREDOS (OBRIGATÓRIOS)
# ----------------------------------------------------------------------------
# Chave de assinatura JWT — openssl rand -hex 32
JWT_SECRET=substitua-por-uma-chave-aleatoria-de-32-caracteres

# AES-256-GCM — 64 caracteres hex (32 bytes) — openssl rand -hex 32
ENCRYPTION_KEY=substitua-por-uma-chave-de-32-caracteres

# E-mail do super admin (protegido contra alteração de permissão)
SUPER_ADMIN_EMAIL=admin@exemplo.com
# Senha inicial do super admin (criada na 1ª execução)
SUPER_ADMIN_PASSWORD=Admin@2026

# ----------------------------------------------------------------------------
# BANCO DE DADOS
# ----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=manutencao_urbana
DB_USER=urbana
DB_PASSWORD=substitua-por-uma-senha-forte

# ----------------------------------------------------------------------------
# FRONTEND
# ----------------------------------------------------------------------------
# Dev: http://localhost:5173  |  Prod: https://tcc.josemurilors.com.br
FRONTEND_URL=http://localhost:5173
DOMAIN=localhost

# ----------------------------------------------------------------------------
# IA
# ----------------------------------------------------------------------------
IA_URL=http://ia:8000
# Token opcional para fallback de classificação via Hugging Face
HUGGINGFACE_API_TOKEN=
CLASSIFICATION_API_URL=https://api-inference.huggingface.co/models/facebook/bart-large-mnli
CLASSIFICATION_FORMAT=huggingface
CLASSIFICATION_CATEGORIES=Buraco,Iluminacao,Semafaro,Arvore Caida,Entulho,Calcada Danificada,Outro

# ----------------------------------------------------------------------------
# NOTIFICAÇÕES PUSH (Web Push VAPID)
# ----------------------------------------------------------------------------
# Gere com: docker compose run --rm backend node src/services/generate-vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ----------------------------------------------------------------------------
# E-MAIL (Resend — opcional)
# ----------------------------------------------------------------------------
RESEND_API_KEY=
FROM_EMAIL=Central Urbana <onboarding@resend.dev>

# ----------------------------------------------------------------------------
# PRIVACIDADE / GPS
# ----------------------------------------------------------------------------
# Sigma do blur gaussiano aplicado nas fotos (atenuação de privacidade)
PRIVACY_BLUR_SIGMA=0.6
# Tolerância em graus para validação de perímetro municipal (0.01 ≈ 1km)
PERIMETER_BUFFER_DEG=0.01

# ----------------------------------------------------------------------------
# LOGGING / SEGURANÇA
# ----------------------------------------------------------------------------
LOG_LEVEL=info
# Hosts permitidos separados por vírgula
ALLOWED_HOSTS=localhost,backend
# Dev: false | Prod: true
SECURE_SSL_REDIRECT=false

# ----------------------------------------------------------------------------
# BACKUP (profile "backup" — opcional)
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RCLONE_DEST=
RETENTION_DAYS=30

# ----------------------------------------------------------------------------
# CLOUDFLARE TUNNEL (produção apenas)
# ----------------------------------------------------------------------------
TUNNEL_TOKEN=
