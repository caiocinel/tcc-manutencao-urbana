# Central de Inteligência Urbana — Configuração
# Copie este arquivo para .env e preencha os valores.
#   cp backend/.env.example backend/.env

# =============================================================================
# SEGREDOS (OBRIGATÓRIOS)
# =============================================================================
# Gere com: openssl rand -hex 32
JWT_SECRET=substitua-por-uma-chave-aleatoria-de-32-caracteres

# AES-256-GCM — 64 caracteres hex (32 bytes)
ENCRYPTION_KEY=substitua-por-uma-chave-de-32-caracteres

# =============================================================================
# BANCO DE DADOS (PostgreSQL)
# =============================================================================
# Para Docker: DB_HOST=postgres
# Para desktop local: DB_HOST=localhost
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manutencao_urbana
DB_USER=urbana
DB_PASSWORD=CHANGE_ME
DB_POOL_MAX=10

# =============================================================================
# FRONTEND
# =============================================================================
FRONTEND_URL=http://localhost:5173
DOMAIN=centralurbana.app

# =============================================================================
# IA — Classificação Automática (opcional)
# =============================================================================
# Para Docker: IA_URL=http://ia:8000
# Para desktop local: IA_URL=http://localhost:8000
IA_URL=http://localhost:8000

# Token da Hugging Face (obrigatório se IA_URL usar API cloud)
HUGGINGFACE_API_TOKEN=

# =============================================================================
# NOTIFICAÇÕES PUSH (VAPID)
# =============================================================================
# Gere as chaves executando o servidor uma vez sem essas variáveis
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# =============================================================================
# E-MAIL (Resend / SMTP)
# =============================================================================
# Crie uma chave em https://resend.com/api-keys
# Deixe vazio para desenvolvimento (códigos aparecem no log)
FROM_EMAIL=
RESEND_API_KEY=

# SMTP alternativo
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=seu-email@gmail.com
# EMAIL_PASS=sua-senha-de-app

# =============================================================================
# BACKUP (serviço "backup" — profile "backup")
# =============================================================================
# Notificação via Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Upload para S3/compatível via rclone (opcional)
# Exemplo: RCLONE_DEST=s3:bucket-manutencao-urbana/backups
RCLONE_DEST=

# Retenção em dias
RETENTION_DAYS=30

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info
